# ======== CONFIGURACIÓN DEL BACKEND PROXY ========

# Puerto donde correrá la API (solo localmente; en Vercel es automático)
PORT=3000

# Modo de ejecución
NODE_ENV=development

# Orígenes permitidos del frontend (coma-separados)
# DESARROLLO: http://localhost:5500 (Live Server Port)
# PRODUCCIÓN: Agregar tu URL de GitHub Pages, Vercel, etc.
# Ejemplo: http://localhost:5500,https://vwmadrid.github.io/entregas
FRONTEND_ORIGIN=http://localhost:5500

# ======== FIREBASE (CRÍTICO PARA PRODUCCIÓN) ========
# JSON de la cuenta de servicio de Firebase
# 1. Ve a Firebase Console: https://console.firebase.google.com/
# 2. Proyecto > Configuración > Cuentas de servicio > Generar nueva clave privada
# 3. Copia TODO el JSON en UNA SOLA LÍNEA (sin saltos de línea adicionales)
# 4. Pégalo como valor de FIREBASE_SERVICE_ACCOUNT
# 
# NOTA: En Vercel, configura esto como variable de entorno secreta:
#   - Dashboard > Settings > Environment Variables
#   - Nombre: FIREBASE_SERVICE_ACCOUNT
#   - Valor: el JSON de la clave privada
#   - Scope: Production (o All)
FIREBASE_SERVICE_ACCOUNT=

# ======== GOOGLE APPS SCRIPT (OPCIONAL) ========
# URL de tu Google Apps Script para enviar correos, etc.
# Ejemplo: https://script.google.com/macros/s/AKfycbxQ5mMCC7DA0.../exec
GAS_URL=

# ======== PRODUCCIÓN EN VERCEL ========
# Después de desplegar, configura estas variables en Vercel Dashboard:
# 1. NODE_ENV = production
# 2. FIREBASE_SERVICE_ACCOUNT = [tu JSON]
# 3. FRONTEND_ORIGIN = https://vwmadrid.github.io,https://tu-dominio.com
# 4. ENFORCE_HTTPS = true
ENFORCE_HTTPS=false

